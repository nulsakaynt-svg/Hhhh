        TextLabel.BackgroundTransparency = 1
        TextLabel.Size = UDim2.new(1, -10, 0, 20)
        TextLabel.Font = Enum.Font.SourceSans
        TextLabel.TextSize = 14
        TextLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        if sender == LocalPlayer.Name then
            TextLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        elseif sender == "Система" then
            TextLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        else
            TextLabel.TextColor3 = Color3.fromRGB(150, 200, 255)
        end
        
        TextLabel.Text = " [" .. sender .. "]: " .. text
        ChatLog.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
        ChatLog.CanvasPosition = Vector2.new(0, UIListLayout.AbsoluteContentSize.Y)
    end

    -- Отправка сообщений
    local function sendMessage(text)
        if text == "" then return end
        task.spawn(function()
            pcall(function()
                local msgObj = Instance.new("StringValue")
                msgObj.Name = LocalPlayer.Name
                msgObj.Value = text
                msgObj.Parent = networkFolder
                task.wait(0.1)
                msgObj:Destroy()
            end)
        end)
    end

    networkFolder.ChildAdded:Connect(function(child)
        if child:IsA("StringValue") then
            if child.Value == "" then task.wait() end 
            addMessage(child.Name, child.Value)
        end
    end)

    TextBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage(TextBox.Text)
            TextBox.Text = ""
        end
    end)

    addMessage("Система", "Чат Cups 4561 успешно запущен. Цензура отключена.")
end

